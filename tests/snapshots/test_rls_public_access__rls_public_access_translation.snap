CREATE TABLE IF NOT EXISTS rls_audit (id INTEGER PRIMARY KEY AUTOINCREMENT, table_name TEXT NOT NULL, violation_type TEXT NOT NULL, row_identifier TEXT NOT NULL, policy_name TEXT, detected_at TEXT NOT NULL, severity TEXT NOT NULL, details TEXT, reported_at TEXT) STRICT
CREATE TABLE categories_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL) STRICT
CREATE VIEW categories AS SELECT id, name FROM categories_rls
CREATE TRIGGER categories_insert_trigger INSTEAD OF INSERT ON categories FOR EACH ROW BEGIN INSERT INTO categories_rls (id, name) VALUES (COALESCE(NEW.id, uuidv7()), NEW.name); END
CREATE TRIGGER categories_rls_update_check BEFORE UPDATE ON categories_rls FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER categories_update_trigger INSTEAD OF UPDATE ON categories FOR EACH ROW BEGIN SELECT NULL; END
CREATE TRIGGER categories_delete_trigger INSTEAD OF DELETE ON categories FOR EACH ROW BEGIN SELECT NULL; END
CREATE TRIGGER categories_rls_rls_monitor_insert AFTER INSERT ON categories_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, details, reported_at) SELECT 'categories', 'select_not_visible', 'id=' || quote(NEW.id), 'SELECT policy', datetime('now'), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', NULL WHERE NOT (EXISTS (SELECT 1 FROM categories WHERE categories.id = NEW.id)); END
CREATE TRIGGER categories_rls_rls_monitor_update AFTER UPDATE ON categories_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, details, reported_at) SELECT 'categories', 'select_not_visible', 'id=' || quote(NEW.id), 'SELECT policy', datetime('now'), 'warning', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', NULL WHERE NOT (EXISTS (SELECT 1 FROM categories WHERE categories.id = NEW.id)); END
CREATE VIEW categories_rls_violations AS SELECT id, name FROM categories_rls WHERE NOT EXISTS (SELECT 1 FROM categories WHERE categories_rls.id = categories.id)
CREATE TABLE items_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, category_id BLOB REFERENCES categories_rls (id) CHECK (length(category_id) = 16), name TEXT NOT NULL, owner_id BLOB NOT NULL CHECK (length(owner_id) = 16), is_featured INTEGER NOT NULL DEFAULT false) STRICT
CREATE VIEW items AS SELECT id, category_id, name, owner_id, is_featured FROM items_rls WHERE (is_featured = true OR owner_id = current_app_user())
CREATE TRIGGER items_insert_trigger INSTEAD OF INSERT ON items FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((NEW.owner_id = current_app_user())) IS NOT TRUE; INSERT INTO items_rls (id, category_id, name, owner_id, is_featured) VALUES (COALESCE(NEW.id, uuidv7()), NEW.category_id, NEW.name, NEW.owner_id, COALESCE(NEW.is_featured, false)); END
CREATE TRIGGER items_rls_insert_check BEFORE INSERT ON items_rls FOR EACH ROW WHEN ((NEW.owner_id = current_app_user())) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER items_rls_update_check BEFORE UPDATE ON items_rls FOR EACH ROW WHEN ((OLD.owner_id = current_app_user())) IS NOT TRUE OR ((NEW.owner_id = current_app_user())) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER items_update_trigger INSTEAD OF UPDATE ON items FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((OLD.owner_id = current_app_user())) AND ((NEW.owner_id = current_app_user())) IS NOT TRUE; UPDATE items_rls SET id = NEW.id, category_id = NEW.category_id, name = NEW.name, owner_id = NEW.owner_id, is_featured = NEW.is_featured WHERE (id = OLD.id) AND ((OLD.owner_id = current_app_user())); END
CREATE TRIGGER items_delete_trigger INSTEAD OF DELETE ON items FOR EACH ROW BEGIN DELETE FROM items_rls WHERE (id = OLD.id) AND ((OLD.owner_id = current_app_user())); END
CREATE TRIGGER items_rls_rls_monitor_insert AFTER INSERT ON items_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, details, reported_at) SELECT 'items', 'select_not_visible', 'id=' || quote(NEW.id), 'SELECT policy', datetime('now'), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', NULL WHERE NOT (EXISTS (SELECT 1 FROM items WHERE items.id = NEW.id)); END
CREATE TRIGGER items_rls_rls_monitor_update AFTER UPDATE ON items_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, details, reported_at) SELECT 'items', 'select_not_visible', 'id=' || quote(NEW.id), 'SELECT policy', datetime('now'), 'warning', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', NULL WHERE NOT (EXISTS (SELECT 1 FROM items WHERE items.id = NEW.id)); END
CREATE VIEW items_rls_violations AS SELECT id, category_id, name, owner_id, is_featured FROM items_rls WHERE NOT EXISTS (SELECT 1 FROM items WHERE items_rls.id = items.id)
