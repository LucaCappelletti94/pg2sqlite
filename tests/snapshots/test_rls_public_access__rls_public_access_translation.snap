assertion_line: 98
expression: translated_sql
---
CREATE TABLE categories_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, name TEXT NOT NULL) STRICT
CREATE VIEW categories AS SELECT id, name FROM categories_rls WHERE (true)
CREATE TRIGGER categories_insert_trigger INSTEAD OF INSERT ON categories FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((true)); INSERT INTO categories_rls (id, name) VALUES (NEW.id, NEW.name); END
CREATE TRIGGER categories_update_trigger INSTEAD OF UPDATE ON categories FOR EACH ROW BEGIN UPDATE categories_rls SET id = COALESCE(NEW.id, OLD.id), name = COALESCE(NEW.name, OLD.name) WHERE id = OLD.id; END
CREATE TRIGGER categories_delete_trigger INSTEAD OF DELETE ON categories FOR EACH ROW BEGIN DELETE FROM categories_rls WHERE id = OLD.id; END
CREATE TABLE items_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, category_id BLOB REFERENCES categories_rls (id), name TEXT NOT NULL, owner_id BLOB NOT NULL, is_featured INTEGER NOT NULL DEFAULT false) STRICT
CREATE VIEW items AS SELECT id, category_id, name, owner_id, is_featured FROM items_rls WHERE (is_featured = true OR owner_id = current_app_user())
CREATE TRIGGER items_insert_trigger INSTEAD OF INSERT ON items FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((NEW.owner_id = current_app_user())); INSERT INTO items_rls (id, category_id, name, owner_id, is_featured) VALUES (NEW.id, NEW.category_id, NEW.name, NEW.owner_id, NEW.is_featured); END
CREATE TRIGGER items_update_trigger INSTEAD OF UPDATE ON items FOR EACH ROW BEGIN UPDATE items_rls SET id = COALESCE(NEW.id, OLD.id), category_id = COALESCE(NEW.category_id, OLD.category_id), name = COALESCE(NEW.name, OLD.name), owner_id = COALESCE(NEW.owner_id, OLD.owner_id), is_featured = COALESCE(NEW.is_featured, OLD.is_featured) WHERE (id = OLD.id) AND ((OLD.owner_id = current_app_user())); END
CREATE TRIGGER items_delete_trigger INSTEAD OF DELETE ON items FOR EACH ROW BEGIN DELETE FROM items_rls WHERE (id = OLD.id) AND ((OLD.owner_id = current_app_user())); END
