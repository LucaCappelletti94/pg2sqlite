---
source: tests/test_trigger_conditional.rs
expression: translated_sql
---
CREATE TABLE customer_orders (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, customer_email TEXT NOT NULL, total_amount REAL NOT NULL) STRICT
CREATE TABLE notifications (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, order_id BLOB NOT NULL CHECK (length(order_id) = 16), notification_type TEXT NOT NULL, message TEXT NOT NULL, priority INTEGER NOT NULL DEFAULT 0 CHECK (priority BETWEEN -2147483648 AND 2147483647)) STRICT
CREATE TRIGGER notify_new_order_trigger AFTER INSERT ON customer_orders FOR EACH ROW BEGIN INSERT INTO notifications (id, order_id, notification_type, message, priority) WITH v_notif_id (val) AS (SELECT uuidv7()) SELECT (SELECT val FROM v_notif_id), NEW.id, 'ORDER_RECEIVED', 'Order confirmation sent', 1 WHERE (NOT EXISTS (SELECT 1 FROM notifications WHERE order_id = NEW.id AND notification_type = 'ORDER_RECEIVED')); END
