assertion_line: 121
expression: translated_sql
---
CREATE TABLE embeddings_rls (id INTEGER PRIMARY KEY NOT NULL, content TEXT NOT NULL, embedding BLOB) STRICT
CREATE VIEW embeddings AS SELECT id, content, embedding FROM embeddings_rls WHERE (true)
CREATE TRIGGER embeddings_insert_trigger INSTEAD OF INSERT ON embeddings FOR EACH ROW BEGIN INSERT INTO embeddings_rls (id, content, embedding) VALUES (NEW.id, NEW.content, NEW.embedding); END
CREATE TRIGGER embeddings_update_trigger INSTEAD OF UPDATE ON embeddings FOR EACH ROW BEGIN UPDATE embeddings_rls SET id = COALESCE(NEW.id, OLD.id), content = COALESCE(NEW.content, OLD.content), embedding = COALESCE(NEW.embedding, OLD.embedding) WHERE (id = OLD.id) AND ((true)); END
CREATE TRIGGER embeddings_delete_trigger INSTEAD OF DELETE ON embeddings FOR EACH ROW BEGIN DELETE FROM embeddings_rls WHERE (id = OLD.id) AND ((true)); END
CREATE VIRTUAL TABLE embeddings_embedding_vec USING vec0 (id_id INTEGER PRIMARY KEY, embedding float[384])
CREATE TRIGGER embeddings_embedding_vec_ai AFTER INSERT ON embeddings_rls BEGIN INSERT INTO embeddings_embedding_vec (id_id, embedding) VALUES (NEW.id, NEW.embedding); END
CREATE TRIGGER embeddings_embedding_vec_ad AFTER DELETE ON embeddings_rls BEGIN DELETE FROM embeddings_embedding_vec WHERE id_id = OLD.id; END
CREATE TRIGGER embeddings_embedding_vec_au AFTER UPDATE OF embedding ON embeddings_rls BEGIN UPDATE embeddings_embedding_vec SET embedding = NEW.embedding WHERE id_id = NEW.id; END
