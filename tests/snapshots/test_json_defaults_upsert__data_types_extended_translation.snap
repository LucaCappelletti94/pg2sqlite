CREATE TABLE json_data (id INTEGER PRIMARY KEY NOT NULL, metadata TEXT, settings TEXT NOT NULL DEFAULT '{}') STRICT
CREATE TABLE complex_defaults (id INTEGER PRIMARY KEY NOT NULL, negative_value INTEGER NOT NULL DEFAULT -1 CHECK (negative_value BETWEEN -2147483648 AND 2147483647), calculated REAL NOT NULL DEFAULT 3.14, bool_default INTEGER NOT NULL DEFAULT true, text_default TEXT DEFAULT 'hello') STRICT
CREATE TABLE upsert_test (key TEXT PRIMARY KEY NOT NULL, value TEXT NOT NULL, counter INTEGER NOT NULL DEFAULT 0 CHECK (counter BETWEEN -2147483648 AND 2147483647)) STRICT
