---
source: tests/test_rls_self_referential.rs
expression: translated_sql
---
CREATE TABLE IF NOT EXISTS rls_audit (id INTEGER PRIMARY KEY AUTOINCREMENT, table_name TEXT NOT NULL, violation_type TEXT NOT NULL, row_identifier TEXT NOT NULL, policy_name TEXT, detected_at TEXT NOT NULL, severity TEXT NOT NULL, details TEXT, reported_at TEXT) STRICT
CREATE TABLE app_users_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, email TEXT NOT NULL UNIQUE, display_name TEXT, settings TEXT) STRICT
CREATE VIEW app_users AS SELECT id, email, display_name, settings FROM app_users_rls WHERE (id = current_app_user())
CREATE TRIGGER app_users_insert_trigger INSTEAD OF INSERT ON app_users FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((NEW.id = current_app_user())); INSERT INTO app_users_rls (id, email, display_name, settings) VALUES (NEW.id, NEW.email, NEW.display_name, NEW.settings); END
CREATE TRIGGER app_users_update_trigger INSTEAD OF UPDATE ON app_users FOR EACH ROW BEGIN UPDATE app_users_rls SET id = COALESCE(NEW.id, OLD.id), email = COALESCE(NEW.email, OLD.email), display_name = COALESCE(NEW.display_name, OLD.display_name), settings = COALESCE(NEW.settings, OLD.settings) WHERE (id = OLD.id) AND ((OLD.id = current_app_user())); END
CREATE TRIGGER app_users_delete_trigger INSTEAD OF DELETE ON app_users FOR EACH ROW BEGIN DELETE FROM app_users_rls WHERE id = OLD.id; END
CREATE TRIGGER app_users_rls_rls_monitor_insert AFTER INSERT ON app_users_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, details, reported_at) SELECT 'app_users', 'rls_policy_violation', 'id=' || quote(NEW.id), 'INSERT policy', datetime('now'), 'warning', 'Row inserted into backing table but not visible through RLS view', NULL WHERE NOT (EXISTS (SELECT 1 FROM app_users WHERE app_users.id = NEW.id)); END
CREATE TRIGGER app_users_rls_rls_monitor_update AFTER UPDATE ON app_users_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, details, reported_at) SELECT 'app_users', 'rls_policy_violation', 'id=' || quote(NEW.id), 'UPDATE policy', datetime('now'), 'warning', 'Row updated in backing table but not visible through RLS view', NULL WHERE NOT (EXISTS (SELECT 1 FROM app_users WHERE app_users.id = NEW.id)); END
CREATE VIEW app_users_rls_violations AS SELECT id, email, display_name, settings FROM app_users_rls WHERE NOT EXISTS (SELECT 1 FROM app_users WHERE app_users_rls.id = app_users.id)
