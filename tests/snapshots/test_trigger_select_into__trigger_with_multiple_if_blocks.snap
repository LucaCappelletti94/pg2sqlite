---
source: tests/test_trigger_select_into.rs
expression: translated_sql
---
CREATE TABLE organizations (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, name TEXT NOT NULL, level INTEGER NOT NULL DEFAULT 1) STRICT
CREATE TABLE teams (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, org_id BLOB NOT NULL REFERENCES organizations (id) ON DELETE CASCADE, name TEXT NOT NULL) STRICT
CREATE TABLE members (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, name TEXT NOT NULL) STRICT
CREATE TABLE team_members (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, team_id BLOB NOT NULL REFERENCES teams (id) ON DELETE CASCADE, member_id BLOB NOT NULL REFERENCES members (id) ON DELETE CASCADE, UNIQUE (team_id, member_id)) STRICT
CREATE TABLE membership_audit (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, team_id BLOB NOT NULL, member_id BLOB NOT NULL, org_level INTEGER NOT NULL, action TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP) STRICT
CREATE TRIGGER after_insert_team_members AFTER INSERT ON team_members FOR EACH ROW BEGIN INSERT INTO membership_audit (id, team_id, member_id, org_level, action) WITH v_org_id (val) AS (SELECT (SELECT o.id FROM organizations o JOIN teams t ON t.org_id = o.id WHERE t.id = NEW.team_id LIMIT 1)), v_org_level (val) AS (SELECT (SELECT o.level FROM organizations o JOIN teams t ON t.org_id = o.id WHERE t.id = NEW.team_id LIMIT 1)) SELECT uuidv7(), NEW.team_id, NEW.member_id, v_org_level.val, 'added' FROM v_org_id, v_org_level WHERE (NOT EXISTS (SELECT 1 FROM membership_audit WHERE team_id = NEW.team_id AND member_id = NEW.member_id AND action = 'added')); INSERT INTO membership_audit (id, team_id, member_id, org_level, action) WITH v_org_id (val) AS (SELECT (SELECT o.id FROM organizations o JOIN teams t ON t.org_id = o.id WHERE t.id = NEW.team_id LIMIT 1)), v_org_level (val) AS (SELECT (SELECT o.level FROM organizations o JOIN teams t ON t.org_id = o.id WHERE t.id = NEW.team_id LIMIT 1)) SELECT uuidv7(), NEW.team_id, NEW.member_id, v_org_level.val, 'verified' FROM v_org_id, v_org_level WHERE (NOT EXISTS (SELECT 1 FROM membership_audit WHERE team_id = NEW.team_id AND member_id = NEW.member_id AND action = 'verified')); END
