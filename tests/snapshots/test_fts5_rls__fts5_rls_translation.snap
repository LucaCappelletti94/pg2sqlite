source: tests/test_fts5_rls.rs
assertion_line: 144
expression: translated_sql
---
CREATE TABLE documents_rls (id INTEGER PRIMARY KEY NOT NULL, title TEXT NOT NULL, content TEXT NOT NULL) STRICT
CREATE VIEW documents AS SELECT id, title, content FROM documents_rls WHERE (true)
CREATE TRIGGER documents_insert_trigger INSTEAD OF INSERT ON documents FOR EACH ROW BEGIN INSERT INTO documents_rls (id, title, content) VALUES (NEW.id, NEW.title, NEW.content); END
CREATE TRIGGER documents_update_trigger INSTEAD OF UPDATE ON documents FOR EACH ROW BEGIN UPDATE documents_rls SET id = COALESCE(NEW.id, OLD.id), title = COALESCE(NEW.title, OLD.title), content = COALESCE(NEW.content, OLD.content) WHERE (id = OLD.id) AND ((true)); END
CREATE TRIGGER documents_delete_trigger INSTEAD OF DELETE ON documents FOR EACH ROW BEGIN DELETE FROM documents_rls WHERE (id = OLD.id) AND ((true)); END
CREATE VIRTUAL TABLE documents_fts USING fts5 (title, content)
CREATE TRIGGER documents_fts_ai AFTER INSERT ON documents_rls BEGIN INSERT INTO documents_fts (rowid, title, content) VALUES (new.id, new.title, new.content); END
CREATE TRIGGER documents_fts_ad AFTER DELETE ON documents_rls BEGIN DELETE FROM documents_fts WHERE rowid = old.id; END
CREATE TRIGGER documents_fts_au AFTER UPDATE ON documents_rls BEGIN DELETE FROM documents_fts WHERE rowid = old.id; INSERT INTO documents_fts (rowid, title, content) VALUES (new.id, new.title, new.content); END
