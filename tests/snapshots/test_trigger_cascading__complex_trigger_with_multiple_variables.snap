---
source: tests/test_trigger_cascading.rs
expression: translated_sql
---
CREATE TABLE products (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL, price REAL NOT NULL, initial_stock INTEGER NOT NULL DEFAULT 0) STRICT
CREATE TABLE inventory (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, product_id BLOB NOT NULL UNIQUE CHECK (length(product_id) = 16), quantity INTEGER NOT NULL DEFAULT 0, last_updated TEXT DEFAULT CURRENT_TIMESTAMP) STRICT
CREATE TABLE inventory_audit (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, inventory_id BLOB NOT NULL CHECK (length(inventory_id) = 16), product_id BLOB NOT NULL CHECK (length(product_id) = 16), old_quantity INTEGER, new_quantity INTEGER NOT NULL, change_type TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP) STRICT
CREATE TRIGGER create_product_inventory_trigger AFTER INSERT ON products FOR EACH ROW BEGIN INSERT INTO inventory (id, product_id, quantity) WITH v_inventory_id (val) AS (SELECT uuidv7()) SELECT v_inventory_id.val, NEW.id, NEW.initial_stock FROM v_inventory_id WHERE (NOT EXISTS (SELECT 1 FROM inventory WHERE product_id = NEW.id)); END
CREATE TRIGGER audit_inventory_creation_trigger AFTER INSERT ON inventory FOR EACH ROW BEGIN INSERT INTO inventory_audit (id, inventory_id, product_id, old_quantity, new_quantity, change_type) WITH v_audit_id (val) AS (SELECT uuidv7()) SELECT v_audit_id.val, NEW.id, NEW.product_id, NULL, NEW.quantity, 'INITIAL' FROM v_audit_id WHERE (NOT EXISTS (SELECT 1 FROM inventory_audit WHERE inventory_id = NEW.id AND change_type = 'INITIAL')); END
