CREATE TABLE owners (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL) STRICT
CREATE TABLE groups (id BLOB PRIMARY KEY REFERENCES owners (id) ON DELETE CASCADE NOT NULL, parent_group_id BLOB REFERENCES groups (id) ON DELETE CASCADE, name TEXT NOT NULL) STRICT
CREATE TRIGGER groups_insert_trigger BEFORE INSERT ON groups FOR EACH ROW BEGIN INSERT INTO owners (id) VALUES (NEW.id); END
CREATE TABLE users (id BLOB PRIMARY KEY REFERENCES owners (id) ON DELETE CASCADE NOT NULL, name TEXT NOT NULL) STRICT
CREATE TRIGGER users_insert_trigger BEFORE INSERT ON users FOR EACH ROW BEGIN INSERT INTO owners (id) VALUES (NEW.id); END
CREATE TABLE group_memberships (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, group_id BLOB NOT NULL REFERENCES groups (id) ON DELETE CASCADE, user_id BLOB NOT NULL REFERENCES users (id) ON DELETE CASCADE, UNIQUE (group_id, user_id)) STRICT
CREATE TRIGGER group_membership_insert_trigger AFTER INSERT ON group_memberships FOR EACH ROW BEGIN INSERT OR IGNORE INTO group_memberships (group_id, user_id) SELECT recursive_cte_subquery.id, recursive_cte_subquery.user_id FROM (WITH RECURSIVE parent_groups AS (SELECT parent_group_id AS id FROM groups WHERE id = NEW.group_id UNION ALL SELECT g.parent_group_id FROM groups g JOIN parent_groups pg ON g.id = pg.id) SELECT id, NEW.user_id FROM parent_groups WHERE id IS NOT NULL) recursive_cte_subquery; END
CREATE TRIGGER group_membership_delete_trigger AFTER DELETE ON group_memberships FOR EACH ROW BEGIN DELETE FROM group_memberships WHERE user_id = OLD.user_id AND group_id IN (WITH RECURSIVE child_groups AS (SELECT id FROM groups WHERE parent_group_id = OLD.group_id UNION ALL SELECT g.id FROM groups g JOIN child_groups cg ON g.parent_group_id = cg.id) SELECT id FROM child_groups); END
CREATE TABLE roles (id INTEGER PRIMARY KEY NOT NULL, name TEXT NOT NULL UNIQUE) STRICT
INSERT INTO roles (id, name) VALUES (2, 'viewer'), (3, 'editor')
CREATE TABLE ownables_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, title TEXT NOT NULL, created_by BLOB NOT NULL REFERENCES owners (id) ON DELETE RESTRICT) STRICT
CREATE VIEW ownables AS SELECT id, title, created_by FROM ownables_rls WHERE (EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = ownables_rls.id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa WHERE oa.ownable_id = ownables_rls.id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))) OR EXISTS (SELECT 1 FROM grants_rls g WHERE g.ownable_id = ownables_rls.id AND g.role_id >= 2 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))
CREATE TRIGGER ownables_insert_trigger INSTEAD OF INSERT ON ownables FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((NEW.created_by = current_app_user())); INSERT INTO ownables_rls (id, title, created_by) VALUES (NEW.id, NEW.title, NEW.created_by); END
CREATE TRIGGER ownables_update_trigger INSTEAD OF UPDATE ON ownables FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = NEW.id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa WHERE oa.ownable_id = NEW.id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))) OR EXISTS (SELECT 1 FROM grants_rls g WHERE g.ownable_id = NEW.id AND g.role_id >= 3 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))); UPDATE ownables_rls SET id = COALESCE(NEW.id, OLD.id), title = COALESCE(NEW.title, OLD.title), created_by = COALESCE(NEW.created_by, OLD.created_by) WHERE (id = OLD.id) AND ((EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = OLD.id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa WHERE oa.ownable_id = OLD.id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))) OR EXISTS (SELECT 1 FROM grants_rls g WHERE g.ownable_id = OLD.id AND g.role_id >= 3 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))); END
CREATE TRIGGER ownables_delete_trigger INSTEAD OF DELETE ON ownables FOR EACH ROW BEGIN DELETE FROM ownables_rls WHERE (id = OLD.id) AND ((EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = OLD.id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa WHERE oa.ownable_id = OLD.id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))))); END
CREATE TABLE ownable_owners_rls (ownable_id BLOB NOT NULL REFERENCES ownables_rls (id) ON DELETE CASCADE, owner_id BLOB NOT NULL REFERENCES owners (id) ON DELETE CASCADE, PRIMARY KEY (ownable_id, owner_id)) STRICT
CREATE VIEW ownable_owners AS SELECT ownable_id, owner_id FROM ownable_owners_rls WHERE (EXISTS (SELECT 1 FROM ownable_owners_rls oo2 WHERE oo2.ownable_id = ownable_owners_rls.ownable_id AND (oo2.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo2.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa WHERE oa.ownable_id = ownable_owners_rls.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))) OR EXISTS (SELECT 1 FROM grants_rls g WHERE g.ownable_id = ownable_owners_rls.ownable_id AND g.role_id >= 2 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))
CREATE TRIGGER ownable_owners_insert_trigger INSTEAD OF INSERT ON ownable_owners FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((EXISTS (SELECT 1 FROM ownable_owners_rls oo2 WHERE oo2.ownable_id = NEW.ownable_id AND (oo2.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo2.owner_id))) OR (NEW.owner_id = current_app_user() AND NOT EXISTS (SELECT 1 FROM ownable_owners_rls oo2 WHERE oo2.ownable_id = NEW.ownable_id) AND EXISTS (SELECT 1 FROM ownables_rls o WHERE o.id = NEW.ownable_id AND o.created_by = current_app_user())))); INSERT INTO ownable_owners_rls (ownable_id, owner_id) VALUES (NEW.ownable_id, NEW.owner_id); END
CREATE TRIGGER ownable_owners_update_trigger INSTEAD OF UPDATE ON ownable_owners FOR EACH ROW BEGIN UPDATE ownable_owners_rls SET ownable_id = COALESCE(NEW.ownable_id, OLD.ownable_id), owner_id = COALESCE(NEW.owner_id, OLD.owner_id) WHERE ownable_id = OLD.ownable_id AND owner_id = OLD.owner_id; END
CREATE TRIGGER ownable_owners_delete_trigger INSTEAD OF DELETE ON ownable_owners FOR EACH ROW BEGIN DELETE FROM ownable_owners_rls WHERE (ownable_id = OLD.ownable_id AND owner_id = OLD.owner_id) AND ((EXISTS (SELECT 1 FROM ownable_owners_rls oo2 WHERE oo2.ownable_id = OLD.ownable_id AND (oo2.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo2.owner_id))))); END
CREATE TRIGGER ownables_insert_owner_trigger AFTER INSERT ON ownables_rls FOR EACH ROW BEGIN INSERT INTO ownable_owners (ownable_id, owner_id) VALUES (NEW.id, NEW.created_by); END
CREATE TABLE ownable_administrators_rls (ownable_id BLOB NOT NULL REFERENCES ownables_rls (id) ON DELETE CASCADE, administrator_id BLOB NOT NULL REFERENCES owners (id) ON DELETE CASCADE, granted_by BLOB NOT NULL REFERENCES users (id) ON DELETE CASCADE, PRIMARY KEY (ownable_id, administrator_id)) STRICT
CREATE VIEW ownable_administrators AS SELECT ownable_id, administrator_id, granted_by FROM ownable_administrators_rls WHERE (EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = ownable_administrators_rls.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa2 WHERE oa2.ownable_id = ownable_administrators_rls.ownable_id AND (oa2.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa2.administrator_id))) OR EXISTS (SELECT 1 FROM grants_rls g WHERE g.ownable_id = ownable_administrators_rls.ownable_id AND g.role_id >= 2 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))
CREATE TRIGGER ownable_administrators_insert_trigger INSTEAD OF INSERT ON ownable_administrators FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))))); INSERT INTO ownable_administrators_rls (ownable_id, administrator_id, granted_by) VALUES (NEW.ownable_id, NEW.administrator_id, NEW.granted_by); END
CREATE TRIGGER ownable_administrators_update_trigger INSTEAD OF UPDATE ON ownable_administrators FOR EACH ROW BEGIN UPDATE ownable_administrators_rls SET ownable_id = COALESCE(NEW.ownable_id, OLD.ownable_id), administrator_id = COALESCE(NEW.administrator_id, OLD.administrator_id), granted_by = COALESCE(NEW.granted_by, OLD.granted_by) WHERE ownable_id = OLD.ownable_id AND administrator_id = OLD.administrator_id; END
CREATE TRIGGER ownable_administrators_delete_trigger INSTEAD OF DELETE ON ownable_administrators FOR EACH ROW BEGIN DELETE FROM ownable_administrators_rls WHERE (ownable_id = OLD.ownable_id AND administrator_id = OLD.administrator_id) AND ((EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = OLD.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))))); END
CREATE TABLE grants_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) NOT NULL, ownable_id BLOB NOT NULL REFERENCES ownables_rls (id) ON DELETE CASCADE, grantee_id BLOB NOT NULL REFERENCES owners (id) ON DELETE CASCADE, grantor_id BLOB NOT NULL REFERENCES owners (id) ON DELETE RESTRICT, role_id INTEGER NOT NULL REFERENCES roles (id), UNIQUE (ownable_id, grantee_id)) STRICT
CREATE VIEW grants AS SELECT id, ownable_id, grantee_id, grantor_id, role_id FROM grants_rls WHERE (grantor_id = current_app_user() OR grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = grants_rls.grantee_id) OR EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = grants_rls.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa WHERE oa.ownable_id = grants_rls.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))))
CREATE TRIGGER grants_insert_trigger INSTEAD OF INSERT ON grants FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((NEW.grantor_id = current_app_user() AND (EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_rls oa WHERE oa.ownable_id = NEW.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id)))))); INSERT INTO grants_rls (id, ownable_id, grantee_id, grantor_id, role_id) VALUES (NEW.id, NEW.ownable_id, NEW.grantee_id, NEW.grantor_id, NEW.role_id); END
CREATE TRIGGER grants_update_trigger INSTEAD OF UPDATE ON grants FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE NOT ((COALESCE(NEW.grantor_id, OLD.grantor_id) = current_app_user())); UPDATE grants_rls SET id = COALESCE(NEW.id, OLD.id), ownable_id = COALESCE(NEW.ownable_id, OLD.ownable_id), grantee_id = COALESCE(NEW.grantee_id, OLD.grantee_id), grantor_id = COALESCE(NEW.grantor_id, OLD.grantor_id), role_id = COALESCE(NEW.role_id, OLD.role_id) WHERE (id = OLD.id) AND ((OLD.grantor_id = current_app_user())); END
CREATE TRIGGER grants_delete_trigger INSTEAD OF DELETE ON grants FOR EACH ROW BEGIN DELETE FROM grants_rls WHERE (id = OLD.id) AND ((OLD.grantor_id = current_app_user() OR EXISTS (SELECT 1 FROM ownable_owners_rls oo WHERE oo.ownable_id = OLD.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))))); END
